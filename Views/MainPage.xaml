<Page
    x:Class="Inticate_Auto_Clicker.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Click Interval -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Click Interval (ms):" VerticalAlignment="Center" Margin="0,0,10,0" />
                <NumberBox x:Name="IntervalInput"
                           Value="1"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="1"
                           LargeChange="10"
                           ValueChanged="IntervalChanged"
                           AcceptsExpression="False"
                           Minimum="1" />
            </StackPanel>

            <!-- Mouse Button Choice -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Mouse Button:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Width="150" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="KeyChanged">
                    <ComboBoxItem Content="Left Button" />
                    <ComboBoxItem Content="Right Button" />
                    <ComboBoxItem Content="Middle Button" />
                </ComboBox>
            </StackPanel>

            <!-- Start/Stop Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Left">
                <Button Style="{StaticResource AccentButtonStyle}" Content="Start (F6)" Width="100"
                        Click="StartBtnClick" x:Name="StartBtn" />
                <Button Content="Stop (F7)" Width="100" Click="StopBtnClick" x:Name="StopBtn" IsEnabled="False" />
            </StackPanel>

            <!-- Status -->
            <TextBlock x:Name="StatusTextBlock"
                       Text="Status: Stopped"
                       HorizontalAlignment="Left"
                       FontStyle="Italic" />
        </StackPanel>
    </Grid>
</Page>